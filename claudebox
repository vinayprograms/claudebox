#!/bin/bash
# Claudebox - Secure container for running Claude Code
#
# This script builds and runs Claude Code in a security-hardened container
# with network isolation, filesystem restrictions, and audit logging.
#
# See SECURE_CLAUDE_CODE.md for complete security documentation.
#
# Usage:
#   ./claudebox [options] [-- claude-args]
#
# Options:
#   --no-proxy          Run without network proxy (less secure)
#   --ca-cert <file>    Custom CA certificate (for TLS inspection proxies)
#   --build-only        Only build the container, don't run
#   --shell             Start a shell instead of Claude Code
#   --help              Show this help message
#
# Environment variables:
#   CLAUDE_CREDENTIALS_FILE  Path to age-encrypted credentials
#   OP_VAULT                 1Password vault name
#   OP_ITEM                  1Password item name

set -e

#######################################
# Configuration

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLAUDE_DIR="$SCRIPT_DIR/claude-config"
LOG_DIR="$SCRIPT_DIR/claudebox-logs"

# Container settings
IMAGE_NAME="claudebox:latest"
PROXY_IMAGE_NAME="claudebox-proxy:latest"
NETWORK_NAME="claudebox-internal"


#######################################
# Helper functions

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[claudebox]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[claudebox]${NC} $1"; }
log_error() { echo -e "${RED}[claudebox]${NC} $1" >&2; }
log_header() { echo -e "${CYAN}=== $1 ===${NC}"; }

show_help() {
    cat << EOF
Claudebox - Secure container for running Claude Code

Usage:
  ./claudebox [options] [-- claude-args]

Options:
  --no-proxy              Run without network proxy (less secure, but simpler)
  --ca-cert <file>        Custom CA certificate to trust (for TLS inspection proxies)
  --build-only            Only build the container, don't run
  --shell                 Start a shell instead of Claude Code
  --skip-plugin-warning   Skip the plugin warning prompt (banner still shown)
  --help                  Show this help message

Environment variables:
  CLAUDE_CREDENTIALS_FILE  Path to age-encrypted credentials file
  OP_VAULT                 1Password vault name (default: Private)
  OP_ITEM                  1Password item name (default: Claude Code)

Examples:
  ./claudebox                             # Run Claude Code with full security
  ./claudebox --no-proxy                  # Run without proxy (simpler setup)
  ./claudebox --ca-cert /path/to/ca.crt   # Trust custom CA (e.g., Zscaler)
  ./claudebox --shell                     # Start a shell for debugging
  ./claudebox -- --help                   # Pass --help to Claude Code

For complete security documentation, see SECURE_CLAUDE_CODE.md
EOF
}

#######################################
# Detect container runtime

detect_runtime() {
    # Check if runtime is installed AND running (not just installed)
    if command -v podman &>/dev/null && podman info &>/dev/null; then
        RUNTIME="podman"
    elif command -v docker &>/dev/null && docker info &>/dev/null; then
        RUNTIME="docker"
    else
        log_error "No running container runtime found."
        log_error "Please start podman or docker and try again."
        exit 1
    fi
    log_info "Using container runtime: $RUNTIME"
}

#######################################
# Build containers

build_main_container() {
    local ca_cert_file="$1"
    local build_args=()

    # Pass CA cert as build arg if provided (for TLS inspection proxies)
    # Note: base64 | tr -d '\n' is used for cross-platform compatibility (macOS lacks -w0)
    if [[ -n "$ca_cert_file" ]]; then
        build_args+=("--build-arg" "CA_CERT_BASE64=$(base64 "$ca_cert_file" | tr -d '\n')")
    fi

    log_header "Building Claudebox container"
    $RUNTIME build "${build_args[@]}" -f "$SCRIPT_DIR/Containerfile" -t "$IMAGE_NAME" "$SCRIPT_DIR"
}

build_proxy_container() {
    log_header "Building proxy container"
    $RUNTIME build -f "$SCRIPT_DIR/proxy/Containerfile" -t "$PROXY_IMAGE_NAME" "$SCRIPT_DIR/proxy"
}

#######################################
# Network setup

setup_network() {
    # Check if network exists (use 'inspect' for Docker compatibility)
    if ! $RUNTIME network inspect "$NETWORK_NAME" &>/dev/null; then
        log_info "Creating internal network: $NETWORK_NAME"
        $RUNTIME network create --internal "$NETWORK_NAME"
    fi
}

#######################################
# Proxy management

reload_proxy_config() {
    # Reload squid config (handles unchanged configs gracefully)
    log_info "Reloading proxy allowlist..."
    $RUNTIME exec claudebox-proxy squid -k reconfigure 2>/dev/null || \
        log_warn "Failed to reload proxy config"
}

start_proxy() {
    # Check if proxy is already running
    if $RUNTIME ps --format '{{.Names}}' | grep -q "^claudebox-proxy$"; then
        log_info "Proxy container already running"
        reload_proxy_config
        return 0
    fi

    # Remove any stopped proxy container from previous runs
    if $RUNTIME ps -a --format '{{.Names}}' | grep -q "^claudebox-proxy$"; then
        log_info "Removing stopped proxy container..."
        $RUNTIME rm claudebox-proxy
    fi

    log_info "Starting proxy container..."

    # Proxy needs external network access to forward requests
    # Start on default network first, then connect to internal network
    # Note: mode=1777 on tmpfs allows squid user to write (container runs as squid)
    $RUNTIME run -d --rm \
        --name claudebox-proxy \
        --cap-drop ALL \
        --read-only \
        --tmpfs /var/cache/squid:size=100M,mode=1777 \
        --tmpfs /var/log/squid:size=10M,mode=1777 \
        --tmpfs /var/run/squid:size=1M,mode=1777 \
        -v "$SCRIPT_DIR/proxy":/etc/squid/host-config:ro \
        "$PROXY_IMAGE_NAME"

    # Connect proxy to internal network so main container can reach it
    log_info "Connecting proxy to internal network..."
    $RUNTIME network connect "$NETWORK_NAME" claudebox-proxy

    # Wait for proxy to be ready
    log_info "Waiting for proxy to start..."
    sleep 2
}

stop_proxy() {
    if $RUNTIME ps --format '{{.Names}}' | grep -q "^claudebox-proxy$"; then
        log_info "Stopping proxy container..."
        $RUNTIME stop claudebox-proxy 2>/dev/null
        $RUNTIME rm claudebox-proxy 2>/dev/null
    fi
}

# Check if other claudebox instances are using the proxy
# Returns 0 if other instances exist, 1 if we're the last one
other_instances_exist() {
    # List containers on the internal network, excluding the proxy
    local other_containers
    other_containers=$($RUNTIME ps --format '{{.Names}}' \
        --filter "network=$NETWORK_NAME" 2>/dev/null | \
        grep -v "^claudebox-proxy$" | \
        wc -l | tr -d ' ')

    # If any non-proxy containers exist, other instances are running
    [[ "$other_containers" -gt 0 ]]
}

# Intelligent proxy cleanup - only stop if no other instances are using it
cleanup_proxy_if_unused() {
    if [[ "$USE_PROXY" != "true" ]]; then
        return
    fi

    # Give a moment for our container to fully exit
    sleep 1

    if other_instances_exist; then
        log_info "Other claudebox instances running - keeping proxy alive"
    else
        log_info "No other claudebox instances - stopping proxy"
        stop_proxy
    fi
}

#######################################
# Credential handling

get_credentials() {
    CREDS_FILE=""

    # Only try 1Password if user explicitly configured it (not just because op is installed)
    if [[ -n "$OP_VAULT" ]] || [[ -n "$OP_ITEM" ]]; then
        if command -v op &>/dev/null && op account list &>/dev/null 2>&1; then
            log_info "Using 1Password for credentials..."
            if CREDS_FILE=$("$SCRIPT_DIR/scripts/inject-credentials-1password.sh" 2>&1); then
                return 0
            else
                log_warn "Failed to retrieve credentials from 1Password. Continuing without."
                CREDS_FILE=""
            fi
        else
            log_warn "1Password configured but not signed in. Continuing without credentials."
        fi
    fi

    # Try age-encrypted file
    ENCRYPTED_FILE="${CLAUDE_CREDENTIALS_FILE:-$HOME/.claude/credentials.json.age}"
    if [[ -f "$ENCRYPTED_FILE" ]]; then
        log_info "Using age-encrypted credentials..."
        if CREDS_FILE=$("$SCRIPT_DIR/scripts/inject-credentials-age.sh" 2>&1); then
            return 0
        else
            log_warn "Failed to decrypt credentials. Continuing without."
            CREDS_FILE=""
        fi
    fi

    # Try plaintext credentials (warn user)
    PLAIN_CREDS="$CLAUDE_DIR/.claude/.credentials.json"
    if [[ -f "$PLAIN_CREDS" ]]; then
        log_warn "Using plaintext credentials (consider encrypting with ./scripts/setup-credentials.sh)"
        CREDS_FILE="$PLAIN_CREDS"
        return 0
    fi

    # No credentials found - Claude Code will prompt for auth
    log_info "No credentials found. Claude Code will prompt for authentication."
    return 0
}

cleanup_credentials() {
    # Only clean up if we created a temp file
    if [[ -n "$CREDS_FILE" ]] && [[ "$CREDS_FILE" == /tmp/* || "$CREDS_FILE" == /dev/shm/* ]]; then
        log_info "Cleaning up temporary credentials..."
        shred -u "$CREDS_FILE" 2>/dev/null || rm -f "$CREDS_FILE"
    fi
}

#######################################
# Logging setup

setup_logging() {
    mkdir -p "$LOG_DIR"

    # Create log file if it doesn't exist
    LOG_FILE="$LOG_DIR/commands.log"
    if [[ ! -f "$LOG_FILE" ]]; then
        touch "$LOG_FILE"
    fi

    # Try to set append-only attribute (requires root on host)
    if command -v chattr &>/dev/null; then
        sudo chattr +a "$LOG_FILE" 2>/dev/null || \
            log_warn "Could not set append-only on log file (requires sudo)"
    fi
}

#######################################
# Plugin staging (avoids macOS secd hangs)

prepare_plugins() {
    local plugins_dir="$CLAUDE_DIR/.claude/plugins"
    local staging_dir="$CLAUDE_DIR/.claude/plugins-staging"

    if [[ -d "$plugins_dir" ]]; then
        log_info "Syncing plugins to staging directory..."
        mkdir -p "$staging_dir"
        # Sync plugins excluding .git (which contains executables that trigger macOS security scanning)
        rsync -a --delete --exclude='.git' "$plugins_dir/" "$staging_dir/"
    fi
}

sync_plugins_back() {
    local plugins_dir="$CLAUDE_DIR/.claude/plugins"
    local staging_dir="$CLAUDE_DIR/.claude/plugins-staging"

    if [[ -d "$staging_dir" ]] && [[ -d "$plugins_dir" ]]; then
        log_info "Syncing plugin changes back..."
        # Sync changes back, preserving .git in the original
        rsync -a --exclude='.git' "$staging_dir/" "$plugins_dir/"
    fi
}

#######################################
# Directory setup

setup_directories() {
    # Create config directory structure
    # This entire directory is mounted as ~/.claude inside the container
    mkdir -p "$CLAUDE_DIR/.claude/projects"

    # Create empty settings files if they don't exist
    [[ -f "$CLAUDE_DIR/.claude/settings.json" ]] || echo '{}' > "$CLAUDE_DIR/.claude/settings.json"
    [[ -f "$CLAUDE_DIR/.claude/settings.local.json" ]] || echo '{}' > "$CLAUDE_DIR/.claude/settings.local.json"
}

#######################################
# Main container run

run_container() {
    local use_proxy="$1"
    local run_shell="$2"
    local skip_plugin_warning="$3"
    local ca_cert_file="$4"
    shift 4
    local claude_args=("$@")

    # Build mount arguments
    local mounts=()

    # Workspace: Mount CURRENT WORKING DIRECTORY, not script directory
    # SECURITY: This ensures claudebox installation files (proxy/allowlist.conf,
    # seccomp-profile.json, etc.) are NOT accessible to Claude Code
    local workspace_dir="$PWD"
    mounts+=("-v" "$workspace_dir:/workspace:rw")

    # Claude config mounts - two modes based on whether credentials exist
    local creds_on_host="$CLAUDE_DIR/.claude/.credentials.json"

    # Claude Code uses ~/.claude.json (in home dir) for session state - must be rw
    local claude_json="$CLAUDE_DIR/.claude.json"
    [[ -f "$claude_json" ]] || echo '{}' > "$claude_json"
    mounts+=("-v" "$claude_json:/home/claude-agent/.claude.json:rw")

    if [[ -f "$creds_on_host" ]]; then
        log_info "Existing credentials found - using secured mode"

        # Mount .claude directly, then shadow specific paths
        mounts+=("-v" "$CLAUDE_DIR/.claude:/home/claude-agent/.claude:rw")

        # Shadow credentials - rw needed for token refresh
        # TODO: Consider ro mount with periodic sync for better security
        mounts+=("-v" "$creds_on_host:/home/claude-agent/.claude/.credentials.json:rw")

        # Shadow plugins/ with staging directory (excludes .git to avoid macOS secd hangs)
        [[ -d "$CLAUDE_DIR/.claude/plugins-staging" ]] && \
            mounts+=("-v" "$CLAUDE_DIR/.claude/plugins-staging:/home/claude-agent/.claude/plugins:rw")
    else
        # First-time setup: mount .claude directory writable for initial authentication
        log_warn "No credentials found - running in SETUP MODE"
        log_warn "After authentication, restart to enable secured mode"
        log_warn "Credentials will be saved to: $creds_on_host"
        mounts+=("-v" "$CLAUDE_DIR/.claude:/home/claude-agent/.claude:rw")
    fi

    # Command logs (read-write)
    mounts+=("-v" "$LOG_DIR:/var/log/claudebox:rw")

    # Custom CA certificate support (for TLS inspection proxies like Zscaler)
    if [[ -n "$ca_cert_file" ]]; then
        mounts+=("-v" "$ca_cert_file:/etc/claudebox/custom-ca.crt:ro")
    fi

    # Build environment arguments
    local env_args=()

    if [[ "$use_proxy" == "true" ]]; then
        env_args+=("-e" "HTTP_PROXY=http://claudebox-proxy:3128")
        env_args+=("-e" "HTTPS_PROXY=http://claudebox-proxy:3128")
        env_args+=("-e" "http_proxy=http://claudebox-proxy:3128")
        env_args+=("-e" "https_proxy=http://claudebox-proxy:3128")
    fi

    if [[ "$skip_plugin_warning" == "true" ]]; then
        env_args+=("-e" "SKIP_PLUGIN_WARNING=1")
    fi

    if [[ -n "$ca_cert_file" ]]; then
        env_args+=("-e" "CUSTOM_CA_CERT=1")
    fi

    # Build network arguments
    # Note: Don't override DNS - podman's internal network provides DNS for container
    # names (e.g., claudebox-proxy). The proxy allowlist controls external access.
    local net_args=()
    if [[ "$use_proxy" == "true" ]]; then
        net_args+=("--network" "$NETWORK_NAME")
    fi

    # Build security arguments (actual security controls, not resource limits)
    local security_args=(
        "--read-only"
        "--cap-drop" "ALL"
        "--security-opt" "no-new-privileges"
    )

    # Runtime-specific options
    if [[ "$RUNTIME" == "podman" ]]; then
        security_args+=("--pid=private" "--ipc=private")
        security_args+=("--security-opt" "seccomp=$SCRIPT_DIR/seccomp-profile.json")
    fi
    # Note: Docker's default seccomp profile is sufficient; custom profile causes hangs

    # Temp filesystems
    local tmpfs_args=(
        "--tmpfs" "/tmp:size=100M,mode=1777"
        "--tmpfs" "/run:size=10M,mode=755"
    )

    # Add tmpfs mounts for CA certificate directories when custom CA cert is provided
    # This allows update-ca-certificates to run on read-only filesystem
    if [[ -n "$ca_cert_file" ]]; then
        tmpfs_args+=("--tmpfs" "/usr/local/share/ca-certificates:size=1M,mode=755")
        tmpfs_args+=("--tmpfs" "/etc/ssl/certs:size=1M,mode=755")
    fi

    # Determine command
    local cmd_args=()
    if [[ "$run_shell" == "true" ]]; then
        cmd_args=("/bin/bash")
    elif [[ ${#claude_args[@]} -gt 0 ]]; then
        # Prepend 'claude' command when passing extra arguments
        cmd_args=("claude" "--dangerously-skip-permissions" "${claude_args[@]}")
    fi

    log_header "Starting Claudebox"
    log_info "Workspace: $workspace_dir"
    log_info "Proxy: $([[ "$use_proxy" == "true" ]] && echo "enabled" || echo "disabled")"
    [[ -n "$ca_cert_file" ]] && log_info "Custom CA: $(basename "$ca_cert_file")"

    # Run the container
    # Use consistent hostname so Claude Code recognizes the installation across runs
    local init_arg=""
    if [[ "$RUNTIME" == "docker" ]]; then
        # Docker needs --init for proper TTY/signal handling on macOS
        init_arg="--init"
    fi

    # Debug: show the full command
    if [[ -n "$CLAUDEBOX_DEBUG" ]]; then
        log_info "Command: $RUNTIME run --rm -it $init_arg --hostname claudebox ${mounts[*]} ${env_args[*]} ${net_args[*]} ${security_args[*]} ${tmpfs_args[*]} $IMAGE_NAME ${cmd_args[*]}"
    fi

    $RUNTIME run --rm -it $init_arg \
        --hostname claudebox \
        "${mounts[@]}" \
        "${env_args[@]}" \
        "${net_args[@]}" \
        "${security_args[@]}" \
        "${tmpfs_args[@]}" \
        "$IMAGE_NAME" \
        "${cmd_args[@]}"
}

#######################################
# Main

main() {
    local use_proxy=true
    local build_only=false
    local run_shell=false
    local skip_plugin_warning=false
    local ca_cert_file=""
    local claude_args=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-proxy)
                use_proxy=false
                shift
                ;;
            --ca-cert)
                if [[ -z "$2" ]] || [[ "$2" == --* ]]; then
                    log_error "--ca-cert requires a file path argument"
                    exit 1
                fi
                ca_cert_file="$2"
                shift 2
                ;;
            --build-only)
                build_only=true
                shift
                ;;
            --shell)
                run_shell=true
                shift
                ;;
            --skip-plugin-warning)
                skip_plugin_warning=true
                shift
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            --)
                shift
                claude_args=("$@")
                break
                ;;
            *)
                claude_args+=("$1")
                shift
                ;;
        esac
    done

    # Validate CA cert file if specified
    if [[ -n "$ca_cert_file" ]]; then
        if [[ ! -f "$ca_cert_file" ]]; then
            log_error "CA certificate file not found: $ca_cert_file"
            exit 1
        fi
        # Convert to absolute path
        ca_cert_file="$(cd "$(dirname "$ca_cert_file")" && pwd)/$(basename "$ca_cert_file")"
        log_info "Using custom CA certificate: $ca_cert_file"
    fi

    # Detect runtime
    detect_runtime

    # Build containers
    build_main_container "$ca_cert_file"
    if [[ "$use_proxy" == "true" ]]; then
        build_proxy_container
    fi

    if [[ "$build_only" == "true" ]]; then
        log_info "Build complete."
        exit 0
    fi

    # Setup
    setup_directories
    setup_logging
    prepare_plugins

    # Get credentials
    get_credentials

    # Store proxy state for cleanup function (needs to be global)
    USE_PROXY="$use_proxy"

    # Cleanup on exit: sync plugins, cleanup credentials, stop proxy (if last instance)
    cleanup_on_exit() {
        sync_plugins_back
        cleanup_credentials
        cleanup_proxy_if_unused
    }
    trap cleanup_on_exit EXIT

    # Start proxy if needed
    if [[ "$use_proxy" == "true" ]]; then
        setup_network
        start_proxy
    fi

    # Run the container
    run_container "$use_proxy" "$run_shell" "$skip_plugin_warning" "$ca_cert_file" "${claude_args[@]}"
}

main "$@"
