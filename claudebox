#!/bin/sh
# claudebox: Run Claude Code in an isolated container
# Usage: claudebox [claude args...]

set -eu

IMAGE_NAME="claude-code:latest"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Detect available container runtime (prefer podman)
if command -v podman >/dev/null 2>&1; then
    RUNTIME="podman"
    CONTAINERFILE="${SCRIPT_DIR}/Containerfile"
elif command -v docker >/dev/null 2>&1; then
    RUNTIME="docker"
    CONTAINERFILE="${SCRIPT_DIR}/Dockerfile"
else
    printf "Error: No container runtime found. Install podman or docker.\n" >&2
    exit 1
fi

# Check if image exists (different commands for podman vs docker)
image_exists() {
    if [ "$RUNTIME" = "podman" ]; then
        podman image exists "${IMAGE_NAME}" 2>/dev/null
    else
        docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1
    fi
}

# Build image if it doesn't exist
if ! image_exists; then
    printf "Building Claude Code container image using %s...\n" "${RUNTIME}"
    $RUNTIME build -t "${IMAGE_NAME}" -f "${CONTAINERFILE}" "${SCRIPT_DIR}"
fi

# Get current directory as workspace and extract project name
WORKSPACE="$(pwd)"
PROJECT_NAME="$(basename "${WORKSPACE}")"

# Claude home directory with pre-configured settings
CLAUDE_HOME="${SCRIPT_DIR}/claude"

# Karya config directory
KARYA_CONFIG="${SCRIPT_DIR}/karya"

# Run Claude Code in container with workspace mounted
# --rm: Remove container after exit
# --interactive --tty: Enable interactive terminal
# --security-opt=no-new-privileges: Prevent privilege escalation
# --cap-drop=ALL: Drop all capabilities
# --read-only: Read-only root filesystem (workspace is writable)
# --tmpfs: Writable temp directories
# -v: Mount current directory as /workspace/<project>/
# -v: Mount karya config to /home/claude/.config/karya
# -e: Pass through API key if set
exec $RUNTIME run \
    --rm \
    --interactive \
    --tty \
    --security-opt=no-new-privileges \
    --cap-drop=ALL \
    --read-only \
    --tmpfs /tmp:rw,noexec,nosuid \
    -v "${CLAUDE_HOME}:/home/claude:rw" \
    -v "${KARYA_CONFIG}:/home/claude/.config/karya:rw" \
    -v "${WORKSPACE}:/workspace/${PROJECT_NAME}:rw" \
    -v /workspace/zet \
    -e COLORTERM="truecolor" \
    ${ANTHROPIC_API_KEY:+-e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY}"} \
    "${IMAGE_NAME}" \
    --dangerously-skip-permissions \
    "$@"
